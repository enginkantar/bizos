{
  "name": "bizos",
  "version": "0.1.0",
  "description": "AI front desk for small businesses: rules in plain files, limits enforced in code.",
  "license": "MIT",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "start": "node --env-file-if-exists=.env server/src/index.ts",
    "dev": "node --env-file-if-exists=.env --watch server/src/index.ts",
    "web": "python3 -m http.server 5173 --bind 127.0.0.1 --directory web",
    "build": "tsc --noEmit",
    "test": "node --test \"server/test/*.test.ts\" \"web/test/*.test.js\"",
    "lint": "node --check web/src/app.js && node --check web/src/demo-store.js && node --check web/src/live-store.js && node --check web/src/widget.js"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "typescript": "^5.9.0"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^1.3.0",
    "yaml": "^2.9.1"
  }
}
