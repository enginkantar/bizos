{
  "name": "bizos",
  "version": "0.1.0",
  "description": "AI front desk for small businesses: rules in plain files, limits enforced in code.",
  "license": "MIT",
  "private": true,
  "type": "module",
  "workspaces": ["web"],
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "start": "node --env-file-if-exists=.env server/src/index.ts",
    "dev": "node --env-file-if-exists=.env --watch server/src/index.ts",
    "web": "npm start --workspace web",
    "build": "tsc --noEmit && npm run build --workspace web",
    "test": "node --test \"server/test/*.test.ts\" && npm test --workspace web",
    "lint": "npm run lint --workspace web"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "typescript": "^5.9.0"
  },
  "dependencies": {
    "yaml": "^2.9.1"
  }
}
