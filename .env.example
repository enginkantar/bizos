# Copy to .env and fill in. .env is gitignored; never commit it.
# Leave the key empty to run with the agents off: any non-empty value counts as a key.
ANTHROPIC_API_KEY=

# Haiku routes, Sonnet drafts (design document v1.2). Change to trade cost for quality.
ROUTER_MODEL=claude-haiku-5-5
AGENT_MODEL=claude-sonnet-5-5

# Localhost only: the hackathon build has no sign-in for rule edits.
HOST=127.0.0.1
PORT=3000

# Starter pack copied into business/ on first start (templates/<name>/). Empty = never.
STARTER_TEMPLATE=dental-office

# Model calls. Without ANTHROPIC_API_KEY the agents are off anyway; AGENTS=off turns them
# off with a key set (for example to run the demo on canned drafts only).
AGENTS=on
