# Copy to .env and fill in. .env is gitignored; never commit it.
ANTHROPIC_API_KEY=your-key-here

# Haiku routes, Sonnet drafts (design document v1.2). Change to trade cost for quality.
ROUTER_MODEL=claude-haiku-5-5
AGENT_MODEL=claude-sonnet-5-5

# Localhost only: the hackathon build has no sign-in for rule edits.
HOST=127.0.0.1
PORT=3000

# Starter pack copied into business/ on first start (templates/<name>/). Empty = never.
STARTER_TEMPLATE=dental-office
